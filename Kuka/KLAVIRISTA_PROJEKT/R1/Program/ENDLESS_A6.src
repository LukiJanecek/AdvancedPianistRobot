GLOBAL DEF Toggle (A:IN)
BOOL A

IF A THEN
A = FALSE
ELSE
A=TRUE
ENDIF
END

GLOBAL DEFFCT INT MaxNumber (A:IN,B:IN)
INT A
INT B

IF A>B THEN
RETURN A
ENDIF

IF B>A THEN
RETURN B
ELSE
RETURN A
ENDIF

ENDFCT
