&ACCESS RVO
&REL 320
&PARAM DISKPATH = KRC:\R1\Program\Nap0026
DEF BlackKey ()
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)


INTERRUPT DECL 10 WHEN $IN[8] DO STOP_SONG()
INTERRUPT OFF 12
INTERRUPT ON 10 
PIANO_ON_OFF()
IF PyMAX_VOLUME THEN
 VOLUME_MAX()
 ENDIF
SUSTAIN_ON_OFF()
;HAPPY BDAY 
BAR = 600

PLAY_1(100,0,BAR*0.5)
PLAY_1(200,0,BAR*0.5)
PLAY_1(400,0,BAR*0.5)
PLAY_1(500,0,BAR*0.5)


PIANO_ON_OFF()


PULSE($OUT[1], TRUE, 0.5)
;FOLD PyEND reset
PyEND = TRUE
Wait sec 0.2
PyEND = FALSE
;ENDFOLD
END