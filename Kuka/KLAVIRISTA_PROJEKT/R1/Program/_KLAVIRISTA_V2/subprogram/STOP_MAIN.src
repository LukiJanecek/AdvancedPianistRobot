&ACCESS RVO
&REL 2
DEF  STOP_MAIN ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
     IF NOT $ON_PATH THEN
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
    ENDIF
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications her

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

BRAKE
$OUT[8]=TRUE
WAIT SEC 2
WAIT FOR ( $IN[7] OR PyACK)
PyACK = FALSE
PULSE ( $OUT[7], true, 0.5 )
WAIT FOR NOT $IN[8]
$OUT[8]=FALSE
END