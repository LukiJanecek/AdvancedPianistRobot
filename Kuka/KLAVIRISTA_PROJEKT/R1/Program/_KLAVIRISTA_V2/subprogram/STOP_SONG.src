&ACCESS RVO
&REL 18
&PARAM DISKPATH = KRC:\R1\Program\_KLAVIRISTA_V2\subprogram
DEF  STOP_SONG ( )
;FOLD INI
   IF NOT $ON_PATH THEN
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ENDIF
;ENDFOLD (INI)
BRAKE
$OUT[8]=TRUE
IF $TIMER_STOP[5] THEN
WAIT SEC 2
WAIT FOR ( $IN[7] OR PyACK)
ELSE
PyWAIT = TRUE
$TIMER_STOP[5]=TRUE
$TIMER[6]=0
$TIMER_STOP[6]=FALSE
REPEAT
   WAIT SEC 5 ; 2*BAR=5000 = 5s 
UNTIL ( $IN[7] OR PyACK)
$TIMER_STOP[5]=FALSE
$TIMER_STOP[6]=TRUE
PyWAIT=FALSE
ENDIF
PULSE($OUT[7], TRUE, 0.5) ;reset ACK
PyACK=FALSE
WAIT FOR NOT $IN[8]
$OUT[8]=FALSE
END

