&ACCESS RVP
&REL 35
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Diagnostika
DEF _Psaci_Robot_MAIN( )
   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
      ;ENDFOLD (INI)
   PyDopsano=FALSE
   PyPsani=FALSE
   PyBodDopsan=FALSE
   PyDomu=FALSE
   PyDomuFb=FALSE
   PyDomuFb=FALSE

   ;FOLD domu
      SPTP DOMOV WITH $VEL_AXIS[1] = SVEL_JOINT(100), $TOOL = STOOL2(FP1), $BASE = SBASE(FP1.BASE_NO), $IPO_MODE = SIPO_MODE(FP1.IPO_FRAME), $LOAD = SLOAD(FP1.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   ;ENDFOLD
   LOOP

      PyDopsano = FALSE
      PyBodDopsan = FALSE
      PyDomuFb = FALSE

      WAIT FOR PyDomu 
         DOMU()
      PyDomuFb = TRUE
      PyDomu = FALSE

      WAIT FOR PyPsani 
      PyPsani = FALSE
      FOR counter = 1 TO PyNumIter STEP 1

      WAIT FOR PyDalsiBod 
       PyDalsiBod=FALSE 
         Psani()
       WAIT SEC 1 
       PyBodDopsan=TRUE
       WAIT FOR PyOK 
       PyBodDopsan=FALSE
      ENDFOR

      PyDopsano = TRUE
      WAIT SEC 1 
   ENDLOOP
END