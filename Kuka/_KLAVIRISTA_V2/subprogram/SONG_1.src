&ACCESS RVO1
&REL 320
&PARAM DISKPATH = KRC:\R1\Program\_KLAVIRISTA_V2\subprogram
DEF  SONG_1 ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)


INTERRUPT DECL 10 WHEN $IN[8] DO STOP_SONG()
INTERRUPT OFF 12
INTERRUPT ON 10 

PIANO_ON_OFF()
IF PyMAX_VOLUME THEN
 VOLUME_MAX()
 ENDIF
SUSTAIN_ON_OFF()
;HAPPY BDAY 
BAR = 600

PLAY(5,0,BAR*0.5)
PLAY(5,0,BAR*0.5)
PLAY(6,0,BAR*1)
PLAY(5,0,BAR*1)
PLAY(8,0,BAR*1)
PLAY(7,0,BAR*2)

PLAY(5,0,BAR*0.5)
PLAY(5,0,BAR*0.5)
PLAY(6,0,BAR*1)
PLAY(5,0,BAR*1)
PLAY(9,0,BAR*1)
PLAY(8,0,BAR*2)

GRIPPER(2,TRUE)
GRIPPER(3,TRUE)
PLAY(4,0,BAR*0.5)
PLAY(4,0,BAR*0.5)
PLAY(11,0,BAR*1)
PLAY(9,0,BAR*1)
GRIPPER(4,FALSE)
PLAY(6.5,0,BAR*0.5)
PLAY(6.5,0,BAR*0.5)
PLAY(5.5,0,BAR*1)
GRIPPER(3,FALSE)
WAIT SEC 0.5
PLAY(5,0,BAR*3)

PLAY(10,0,BAR*0.5)
PLAY(10,0,BAR*0.5)
PLAY(9,0,BAR*1)
PLAY(7,0,BAR*1)
PLAY(8,0,BAR*1)
GRIPPER(4,FALSE)
PLAY(6.5,0,BAR*3)

GRIPPER(3,TRUE)
GRIPPER(2,TRUE)
GRIPPER(1,TRUE)

PIANO_ON_OFF()


PULSE($OUT[1], TRUE, 0.5)
;FOLD PyEND reset
PyEND = TRUE
Wait sec 0.2
PyEND = FALSE
;ENDFOLD
END