&ACCESS RVO1
DEF  SONG_2 ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 10 WHEN $IN[8] DO STOP_SONG()
INTERRUPT ON 10
INTERRUPT OFF 12
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
PIANO_ON_OFF()
IF PyMAX_VOLUME THEN
 VOLUME_MAX()
 ENDIF
MY_SETUP()
BAR=600
FOR COUNTER = 1 TO 2 STEP 1

PLAY(-2,0,BAR*0.2)
PLAY(-2,0,BAR*0.2)
PLAY(-2,0,BAR*0.2)
PLAY(1,0,BAR*1.2)
PLAY(5,0,BAR*1.2)

PLAY(4,0,0)
PLAY(3,0,0)
PLAY(2,0,0)

PLAY(8,0,BAR*1.3)
PLAY(5,0,BAR*1)

PLAY(4,0,0)
PLAY(3,0,0)
PLAY(2,0,0)

PLAY(8,0,BAR*1.3)
PLAY(5,0,BAR*1)

PLAY(4,0,BAR*0.4)
PLAY(3,0,BAR*0.4)
PLAY(4,0,BAR*0.4)
PLAY(2,0,BAR*3)
ENDFOR

WAIT SEC 2

PIANO_ON_OFF()
;FOLD PyEND reset
PyEND = TRUE
Wait sec 0.2
PyEND = FALSE
;ENDFOLD
END