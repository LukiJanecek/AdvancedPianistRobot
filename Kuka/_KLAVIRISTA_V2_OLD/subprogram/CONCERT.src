GLOBAL DEF PLAY(KEY:IN, TIME:IN, HOLD:IN)
;FOLD Variables INI
REAL KEY 
INT TIME
INT HOLD
INT PRESS
INT SPEED
REAL SHIFT 
;ENDFOLD
PRESS = 10
SHIFT = 23.3
SPEED = 17
$TIMER_STOP[1]=FALSE
;FOLD STATUS TREATMENT
KEY = KEY+7
IF KEY < 11 THEN
XP1 = START4
ELSE
XP1 = START5 
ENDIF
;IF KEY <= 8 THEN
;XP1 = START1
;ENDIF
;IF (KEY > 8) AND (KEY < 11) THEN
;XP1 = START2 
;ENDIF
;IF KEY >= 11 THEN
;XP1 = START3
;ENDIF
;ENDFOLD

XP1.X = XP1.X + (KEY-1) * SHIFT
;FOLD PTP P1 Vel=100 % PDAT1 Tool[4]:TQGripper Base[1]:Piano ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P1; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PPDAT1
FDAT_ACT = FP1
BAS(#PTP_PARAMS, SPEED)
SET_CD_PARAMS (0)
PTP XP1
;ENDFOLD
XP1.Z = XP1.Z - PRESS
WAIT FOR ($TIMER[1] > TIME)
;FOLD PTP P1 Vel=25 % PDAT1 Tool[4]:TQGripper Base[1]:Piano ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P1; Kuka.BlendingEnabled=True; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PPDAT1
FDAT_ACT = FP1
BAS(#PTP_PARAMS, SPEED)
SET_CD_PARAMS (0)
PTP XP1 
;ENDFOLD
$TIMER[1] = 0
XP1.Z = XP1.Z + PRESS
WAIT FOR ($TIMER[1] > HOLD)
;FOLD PTP P1 Vel=100 % PDAT1 Tool[4]:TQGripper Base[1]:Piano ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=P1; Kuka.BlendingEnabled=True; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PPDAT1
FDAT_ACT = FP1
BAS(#PTP_PARAMS, SPEED)
SET_CD_PARAMS (0)
PTP XP1 
;ENDFOLD 
$TIMER_STOP[1]=TRUE
$TIMER[1] = 0
RETURN 
END
