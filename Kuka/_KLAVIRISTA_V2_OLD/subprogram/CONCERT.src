GLOBAL DEF GRIPPER(STATE:IN,CEKEJ:IN)
INT STATE
BOOL CEKEJ

WAIT SEC 0

PULSE($OUT[1+STATE], TRUE, 0.75)
IF CEKEJ THEN
WAIT SEC 0.75
ENDIF
END

