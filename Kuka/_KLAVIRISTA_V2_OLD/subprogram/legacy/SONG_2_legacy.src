&ACCESS RVO
DEF  SONG_2_legacy ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
INTERRUPT DECL 10 WHEN $IN[8] DO STOP_SONG()
INTERRUPT ON 10
INTERRUPT OFF 12
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
PIANO_ON_OFF()
IF PyMAX_VOLUME THEN
 VOLUME_MAX()
 ENDIF
SUSTAIN_ON_OFF()
FOR RANGE= 1 TO 15 STEP 1
   PLAY(RANGE,0,0)
ENDFOR

GRIPPER(2,TRUE)
GRIPPER(3,TRUE)

FOR RANGE= 1 TO 15 STEP 1
   PLAY(16-RANGE,0,0)
ENDFOR

GRIPPER(2,TRUE)
GRIPPER(1,TRUE)

PLAY(1,0,0)
WAIT SEC 2

PIANO_ON_OFF()
;FOLD PyEND reset
PyEND = TRUE
Wait sec 0.2
PyEND = FALSE
;ENDFOLD
END